{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zolai",
  "version": "0.1.0",
  "identifier": "ai.zolai.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Zolai Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "sidecar/zolai-api"
    ],
    "resources": [
      "db/schema.sql",
      "config/llm_providers.yaml"
    ],
    "ios": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24,
      "targetSdkVersion": 34
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "sidecar",
          "cmd": "zolai-api",
          "args": true,
          "sidecar": true
        }
      ]
    }
  }
}
